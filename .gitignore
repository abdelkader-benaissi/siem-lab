*_override.tf.json

# Terraform Variables & Backend (contains project IDs, bucket names)
terraform.tfvars
terraform/terraform.tfvars
*.tfbackend
!*.tfbackend.example

# Ansible Generated Inventory (contains live IPs)
ansible/inventory/hosts.ini
*.retry

# SSH Keys
*.pem
*.key
id_rsa
id_ed25519
gcp_key
gcp_key.pub

# Credentials & Secrets
.env
*.env
**/secrets/
**/credentials/
service-account*.json
*-sa-key.json

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
